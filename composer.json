{
    "name": "ribal/onix",
    "description": "Read and write ONIX for Books 3.0 and 3.1 messages in PHP",
    "type": "library",
    "keywords": ["onix", "onix-for-books", "onix3", "book", "metadata", "publishing", "editeur", "xml"],
    "homepage": "https://github.com/chrisribal/onix-parser",
    "license": "MIT",
    "authors": [
        {
            "name": "Chris Ribal",
            "email": "c.ribal@ribal-webentwicklung.de"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-dom": "*",
        "symfony/serializer": "^7.1",
        "symfony/property-info": "^7.1",
        "symfony/property-access": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "Ribal\\Onix\\": "src/"
        }
    },
    "require-dev": {
        "symfony/var-dumper": "^7.1",
        "fabpot/goutte": "^4.0",
        "symfony/browser-kit": "^6.4",
        "symfony/http-client": "^6.4",
        "symfony/http-kernel": "^7.2",
        "nette/php-generator": "^4.1"
    }
}
